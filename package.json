{
  "name": "daocut-monorepo",
  "private": true,
  "description": "Daocut: the open source AI video agent. The `daocut` package (the format, the CLI and Studio), the desktop app, and what the clients share with the Daocut service.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter daocut dev",
    "dev:desktop": "pnpm --filter @daocut/desktop start",
    "build": "pnpm --filter daocut build:ui && pnpm --filter @daocut/desktop build:shell",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "audit:public": "node scripts/audit-public.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.31.1"
  }
}
